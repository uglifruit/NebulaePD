#N canvas 0 50 1000 700 10;
#X text 10 5 01_drone: demo instrument. pitch=osc pitch(27.5-880Hz) \, overlap=detune \, window=lowpass \,;
#X text 10 20 density=tremolo rate(0-20Hz) \, size=tremolo depth \, blend=dry(adc)/wet(osc).;
#N canvas 0 50 900 520 nebulae_controls 0;
#X text 10 5 Nebulae control receiver (FUDI over TCP 3000). Use [r name] elsewhere.;
#X obj 10 30 netreceive 3000;
#X obj 10 80 route start size density overlap blend window pitch speed record file source reset freeze filestate sourcegate;
#X obj 10 230 route start_alt size_alt density_alt overlap_alt blend_alt window_alt pitch_alt record_alt file_alt source_alt freeze_alt;
