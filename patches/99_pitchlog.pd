#N canvas 0 50 1000 640 10;
#X text 10 5 99_pitchlog: Reset = start a 20 s capture of every pitch message (logical ms - real ms - value). Written to /dev/shm/neb_pitchlog.txt and /tmp/neb_pitchlog.txt. Collect it with fw_backup.instr.;
#N canvas 0 50 900 520 nebulae_controls 0;
