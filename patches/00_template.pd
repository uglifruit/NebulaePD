#N canvas 0 50 700 400 10;
#X text 10 5 00_template: controls + audio passthrough. Copy and build on this.;
#N canvas 0 50 900 520 nebulae_controls 0;
#X text 10 5 Nebulae control receiver (FUDI over TCP 3000). Use [r name] elsewhere.;
#X obj 10 30 netreceive 3000;
#X obj 10 80 route start size density overlap blend window pitch speed record file source reset freeze filestate sourcegate;
#X obj 10 230 route start_alt size_alt density_alt overlap_alt blend_alt window_alt pitch_alt record_alt file_alt source_alt freeze_alt;
#X connect 1 0 2 0;
#X obj 10 130 s start;
#X connect 2 0 4 0;
#X obj 115 130 s size;
#X connect 2 1 5 0;
#X obj 220 130 s density;
#X connect 2 2 6 0;
#X obj 325 130 s overlap;
#X connect 2 3 7 0;
#X obj 430 130 s blend;
#X connect 2 4 8 0;
#X obj 535 130 s window;
#X connect 2 5 9 0;
#X obj 640 130 s pitch;
#X connect 2 6 10 0;
#X obj 745 130 s speed;
#X connect 2 7 11 0;
#X obj 10 160 s record;
#X connect 2 8 12 0;
#X obj 115 160 s file;
#X connect 2 9 13 0;
#X obj 220 160 s source;
#X connect 2 10 14 0;
#X obj 325 160 s reset;
#X connect 2 11 15 0;
#X obj 430 160 s freeze;
#X connect 2 12 16 0;
#X obj 535 160 s filestate;
#X connect 2 13 17 0;
#X obj 640 160 s sourcegate;
#X connect 2 14 18 0;
#X connect 2 15 3 0;
#X obj 10 290 s start_alt;
#X connect 3 0 19 0;
#X obj 150 290 s size_alt;
#X connect 3 1 20 0;
#X obj 290 290 s density_alt;
#X connect 3 2 21 0;
#X obj 430 290 s overlap_alt;
#X connect 3 3 22 0;
#X obj 570 290 s blend_alt;
#X connect 3 4 23 0;
#X obj 710 290 s window_alt;
#X connect 3 5 24 0;
#X obj 10 320 s pitch_alt;
#X connect 3 6 25 0;
#X obj 150 320 s record_alt;
#X connect 3 7 26 0;
#X obj 290 320 s file_alt;
#X connect 3 8 27 0;
#X obj 430 320 s source_alt;
#X connect 3 9 28 0;
#X obj 570 320 s freeze_alt;
#X connect 3 10 29 0;
#X obj 600 30 loadbang;
#X obj 600 55 delay 300;
#X msg 600 80 \; pd dsp 1;
#X connect 30 0 31 0;
#X connect 31 0 32 0;
#X text 10 380 pitch: 0-1 modified log curve - x5 octaves for 1V/oct. clicks to 0.6. speed clicks 0.375-0.625.;
#X text 10 400 speed_alt / reset_alt are consumed by the Nebulae (input gain / reset-all-alts) - not routed here.;
#X restore 10 30 pd nebulae_controls;
#X obj 10 80 adc~ 1 2;
#X obj 10 120 dac~ 1 2;
#X connect 2 0 3 0;
#X connect 2 1 3 1;
#X text 10 160 Use [r density] [r pitch] etc. anywhere in this patch.;
