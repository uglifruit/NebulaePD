*.instr text eol=lf
*.pd text eol=lf
*.csd text eol=lf
# firmware trees go onto the Pi byte-for-byte: no line-ending conversion
firmware/** -text
sc/** text eol=lf

# Pearls stick files: stored byte-exact, so their sha256 matches the build (pearls/README.md)
pearls/** -text
# Bluetooth keyboard: shell, C and Csound files run on the Pi (bt/README.txt is read on Windows)
bt/** text eol=lf
bt/README.txt text eol=crlf
tools/*.sh text eol=lf
