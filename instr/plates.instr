nebconfigbegin
ksmps,32
-B,2048
-b,512
sr,48000
freeze,momentary,rising
reset,momentary,rising
source,latching,falling
file,incremental,falling
record,momentary,rising
speed,0.5
pitch,0.6
start,0.58
size,0.3
density,0.4
window,0.2
overlap,0.3
blend,0.25
start_alt,0.4
size_alt,0.25
density_alt,0.35
window_alt,0.3
overlap_alt,0.2
blend_alt,0
pitch_alt,0
nebconfigend

; plates.instr - an eight-voice drone in four pairs, touched into life, modulating each other (in the spirit of an
; organismic eight-voice drone synth). NebulaePD. Designed with the owner 2026-11-15 (the buttons are touch
; plates, Density = Hold, neighbour FM + a hyper LFO, Blend = distortion); the rest is in docs/PLATES.md. MIT.
;
; Pitch    the lowest pair, 1V/oct (click = C2)
; Start    the pairs' tuning: all on the note fully anticlockwise -> fifths apart (at 0.58) -> octaves apart
; Size     sharp: sine -> square/saw-ish (more overtones)
; Density  Hold: the level every voice drones at untouched (0 = silent until touched)
; Window   FM: each pair modulates the next (pair 4 modulates pair 1): growl -> splinter -> chaos
; Overlap  delay: echoes and feedback (it can run away into self-oscillation near the top)
; Speed    the hyper LFO: none between the clicks; past them two square LFOs (B runs alt Window x A) shake the FM
;          (nearly none <-> full) and the pitch (+-0.25 semitone), faster towards the ends (0.05 .. 30 Hz);
;          anticlockwise the squares are rounded
; Blend    distortion: clean -> driven
; Record   touch pair 1 while held, or while a gate is high (swells in and out)
; Reset    touch pair 2 (as Record)
; Freeze   touch pair 3 (as Record)
; Source   pair 4 on (latching, LED on): a pair that drones by itself
; File     the LFO logic: A OR B -> A AND B -> A + B (four levels)
; alt (hold Source): Start = delay time, Size = detune within each pair (beating), Window = LFO B / A ratio,
;   Density = swell time, Overlap = LFO -> delay time, Blend = the input into the delay and distortion,
;   Speed = input gain (Nebulae's own)
;
; Instruments: 10 control (touches, LFO), 20 the eight voices, 30 delay, distortion, out.

gkLv[] init 4                                   ; each pair's level (Hold or touch, swelling)
giSin ftgen 0, 0, 8192, 10, 1
; "sharp": odd harmonics at 1/n with some even ones (a square leaning to a saw), 24 partials
giSharp ftgen 0, 0, 8192, 10, 1, 0.25, 0.333, 0.125, 0.2, 0.083, 0.143, 0.0625, 0.111, 0.05, 0.091, 0.042, 0.077, 0.036, 0.067, 0.031, 0.059, 0.028, 0.053, 0.025, 0.048, 0.023, 0.043, 0.021
gkLfo init 0
gkLon init 0
gaL init 0
gaR init 0

instr 1
event_i "i", 10, 0, -1
event_i "i", 20, 0, -1
event_i "i", 30, 0, -1
endin

instr 10
; ---- the touches, Hold, the swells; the hyper LFO
klog init 0
kfl trigger gkfilestate, 0.5, 0
if kfl == 1 then
    klog = (klog + 1) % 3
endif
kat = 0.03 + 2.5 * gkdensity_alt * gkdensity_alt  ; swell in (s); out takes twice as long
khold = gkdensity * gkdensity
#define TOUCH(P'G) #
kt$P. = max(khold, ($G. > 0.5 ? 1 : 0))
kl$P. init 0
ktc$P. = (kt$P. > kl$P. ? kat : kat * 2)
kl$P. = kl$P. + (kt$P. - kl$P.) * (1 - exp(-ksmps / (sr * ktc$P.)))
gkLv[$P.] = kl$P.
#
$TOUCH(0'gkrecord)
$TOUCH(1'gkreset)
$TOUCH(2'gkfreeze)
$TOUCH(3'gksource)
; the hyper LFO: two squares, A from Speed, B = A x alt Window's ratio
kd = (gkspeed - 0.5) / 0.375                    ; the clicks at +-0.333
kx = (abs(kd) > 0.333 ? abs(kd) - 0.333 : 0)
kra = 0.05 * pow(600, kx)                       ; 0.05 .. 30 Hz
krb = kra * (0.5 + 3.5 * gkwindow_alt)
kpa init 0
kpb init 0
kpa = frac(kpa + kra * ksmps / sr)
kpb = frac(kpb + krb * ksmps / sr)
ka = (kpa < 0.5 ? 1 : 0)
kb = (kpb < 0.5 ? 1 : 0)
kl = (klog == 0 ? max(ka, kb) : (klog == 1 ? ka * kb : (ka + kb) * 0.5))
; anticlockwise: rounded squares (a 1/(8 x rate) smoothing); clockwise: hard
ksm init 0
ktau = (kd < 0 ? 1 / (8 * kra) : 0.0005)
ksm = ksm + (kl - ksm) * (1 - exp(-ksmps / (sr * ktau)))
gkLfo = ksm
kon init 0
kon = kon + ((kx > 0 ? 1 : 0) - kon) * (1 - exp(-ksmps / (sr * 0.2)))
gkLon = kon
endin

instr 20
; ---- the eight voices: a sine crossfading to a sharp wave (Size), pairs detuned, each pair FM'd by the next
; (squinewave would be neater but Csound 6.09 hasn't got it; 6.11 has, but then nothing here could test it)
kst = (gkpitch - 0.6) * 60
klfo = gkLfo
kon = gkLon
kwob = pow(2, kon * 0.5 * (klfo - 0.5) / 12)   ; the LFO's pitch shake (+-0.25 semitone)
kbase = 65.406 * pow(2, kst / 12) * kwob
ksp = gkloopstart * 12                          ; semitones between pairs
kdet = gkloopsize_alt * 40                      ; cents within a pair
kdn = pow(2, -kdet / 2400)
kup = pow(2, kdet / 2400)
ksh = gkloopsize
ash interp min(1, pow(ksh, 0.7))
kfmd = 2.5 * gkwindow * gkwindow * (1 - kon + kon * (0.1 + 0.9 * klfo))   ; the LFO gates the FM
afmd interp kfmd
aprev init 0
; pair P is modulated by MOD (pair 3 by pair 0's previous block; computed 3, 2, 1, 0)
#define PAIR(P'MOD) #
kf$P. = min(kbase * pow(2, $P. * ksp / 12), 5000)
afm$P. = exp(afmd * $MOD.)
ac$P.a = interp(kf$P. * kdn) * afm$P.
ac$P.b = interp(kf$P. * kup) * afm$P.
as$P.a poscil 1, ac$P.a, giSin
ah$P.a poscil 1, ac$P.a, giSharp
as$P.b poscil 1, ac$P.b, giSin
ah$P.b poscil 1, ac$P.b, giSharp
ao$P. = (as$P.a + as$P.b + (ah$P.a + ah$P.b - as$P.a - as$P.b) * ash) * 0.5 * interp(gkLv[$P.])
#
$PAIR(3'aprev)
$PAIR(2'ao3)
$PAIR(1'ao2)
$PAIR(0'ao1)
aprev = ao0
; out: pairs 1 and 3 left of centre, 2 and 4 right; each pair's two voices a little apart
aL = (ao0 * 0.9 + ao1 * 0.45 + ao2 * 0.8 + ao3 * 0.55) * 0.25
aR = (ao0 * 0.45 + ao1 * 0.9 + ao2 * 0.55 + ao3 * 0.8) * 0.25
gaL = gaL + aL
gaR = gaR + aR
endin

instr 30
; ---- the input, the two delay lines (feedback can self-oscillate, held by a tanh), distortion, out
ain, ainr inch 1, 2
kin = gkblend_alt * gkblend_alt
aL = gaL + ain * kin
aR = gaR + ainr * kin
gaL = 0
gaR = 0
; delay: alt Start = time (right = 1.5 x left), Overlap = feedback and mix, alt Overlap = the LFO on the time
kdt = 0.03 + 1.2 * gkloopstart_alt * gkloopstart_alt
kmod = 1 + gkoverlap_alt * 0.3 * (gkLfo - 0.5) * gkLon
adtL interp kdt * kmod
adtR interp kdt * 1.5 * kmod
kfb = 1.1 * gkoverlap
kmx = min(1, gkoverlap * 1.6) * 0.6
adl delayr 2
atl deltapi adtL
delayw aL + tanh(atl * kfb)
adr delayr 2
atr deltapi adtR
delayw aR + tanh(atr * kfb)
aL = aL + atl * kmx
aR = aR + atr * kmx
; distortion (Blend): an asymmetric drive, level-compensated
; (fully anticlockwise it is clean: a gentle drive with its gain taken back out)
kdr = 0.3 + 20 * gkblend * gkblend
kmk = (kdr < 1 ? 1 / kdr : 1 / sqrt(1 + 0.25 * (kdr - 1)))
kof = 0.1 * min(1, gkblend * 4)
aL = (tanh(aL * kdr + kof) - tanh(kof)) * kmk
aR = (tanh(aR * kdr + kof) - tanh(kof)) * kmk
aL dcblock aL, 0.9995                           ; (the default 0.99 is a 76 Hz high-pass)
aR dcblock aR, 0.9995
outs tanh(aL), tanh(aR)
endin
